{
  "name": "ryanyogan.com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @repo/web dev",
    "build": "pnpm --filter @repo/web build",
    "preview": "pnpm --filter @repo/web preview",
    "deploy": "pnpm --filter @repo/web run deploy",
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test",
    "ready": "pnpm fmt && pnpm lint && pnpm typecheck && pnpm build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @repo/web test",
    "test:e2e": "pnpm --filter @repo/web test:e2e"
  },
  "devDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
