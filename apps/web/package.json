{
  "name": "@repo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-local-db.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "prepreview": "node scripts/ensure-local-db.mjs",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:generate": "node --experimental-strip-types scripts/seed-projects.ts",
    "db:seed:local": "node --experimental-strip-types scripts/seed-projects.ts && wrangler d1 execute DB --local --file db/seed.sql",
    "db:e2e": "sh scripts/e2e-db.sh",
    "test": "vitest run",
    "test:e2e": "pnpm db:e2e && node scripts/e2e-run.mjs",
    "perf:budget": "pnpm db:e2e && node scripts/perf-budget.mjs"
  },
  "dependencies": {
    "@cf-wasm/og": "0.5.0",
    "@repo/shared": "workspace:*",
    "@tanstack/react-router": "^1.114.0",
    "@tanstack/react-start": "^1.114.0",
    "highlight.js": "11.11.1",
    "lowlight": "3.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.31.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "rehype-parse": "^9.0.1",
    "satori": "0.35.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.80.0"
  }
}
