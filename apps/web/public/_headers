# Preview images drawn at build time: the file name carries a hash of the image.
/og/*
  Cache-Control: public, max-age=31536000, immutable

# Prose images encoded at build time: the file name carries a hash of the bytes.
/images/opt/*
  Cache-Control: public, max-age=31536000, immutable

# What the build emits (scripts, the stylesheet, fonts): Vite puts a hash of the contents in
# every file name under /assets, so a changed file is a new URL and a reload need not ask.
# Pages, feeds, /robots.txt and the images under /images are not listed here: they keep the
# asset server's default (ask again every time), since their URLs do not change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The site icon, drawn at build time (vite-plugin-icons.ts). Its names carry no hash and every
# page links to it, so a browser keeps it for a day and then asks whether it changed.
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
